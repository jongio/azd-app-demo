{
  "name": "demo-api",
  "version": "1.0.0",
  "description": "Demo API with intentional bug for AI debugging and testing demonstration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "jest --coverage",
    "test:unit": "jest --coverage --testPathPatterns=test",
    "test:integration": "jest --testPathPatterns=integration"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "glob": "^13.0.6",
    "minimatch": "^10.2.5",
    "test-exclude": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageReporters": [
      "text",
      "cobertura",
      "html"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**"
    ]
  }
}
